+#!/usr/bin/env python3
+"""Check R8 package identity cannot be confused with retained R7."""
+import importlib.util
+import json
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+from unittest.mock import patch
+
+HERE = Path(__file__).resolve().parent
+spec = importlib.util.spec_from_file_location('m4_check', HERE / 'check-kernel-package.py')
+checker = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(checker)
+
+class IdentityTest(unittest.TestCase):
+    def check_identity(self, revision, name, release, should_pass):
+        version = '7.1.13+elementary.m4.gravity1-' + revision
+        versions = json.loads((HERE / 'gravity/compatibility/package-versions.json').read_text())
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp)
+            package = root / 'candidate.deb'
+            package.write_bytes(b'not a real package')
+            (root / 'package.json').write_text(json.dumps({'package_sha256': checker.digest(package)}))
+            (root / 'build.json').write_text(json.dumps({
+                'commit': checker.COMMIT, 'source_archive_sha256': checker.SOURCE_SHA,
+                'kernel_release': release, 'compatibility_patches': versions[version],
+                'm4_idle_checks': {'apple_cpu_wfi_linked': True,
+                    'apple_wfi_quirk_init_linked': True,
+                    'state_save_restore_instructions_present': True,
+                    'm4_wfxt_override_literal_present': True, 'disassembly_sha256': 'a' * 64},
+                'source_contracts': {'boot_cpu_wfi_selection_before_first_idle': True,
+                                     'bcm4388_waits_for_wifi_function': True}}))
+            fields = f'Package: {name}\nVersion: {version}\nArchitecture: arm64\n'
+            argv = ['check-kernel-package.py', '--package', str(package), '--package-receipt', str(root / 'package.json'),
+                    '--build-receipt', str(root / 'build.json'), '--receipt', str(root / 'result.json')]
+            with patch.object(sys, 'argv', argv), patch.object(checker.subprocess, 'check_output', return_value=fields), \
+                 patch.object(checker.subprocess, 'run', side_effect=RuntimeError('reached extraction')):
+                if should_pass:
+                    with self.assertRaisesRegex(RuntimeError, 'reached extraction'): checker.main()
+                else:
+                    with self.assertRaisesRegex(ValueError, 'package name and kernel release'): checker.main()
+
+    def test_retained_r7(self):
+        self.check_identity('7', 'linux-image-elementary-m4-gravity1', checker.LEGACY_RELEASE, True)
+
+    def test_r8(self):
+        self.check_identity('8', 'linux-image-elementary-m4-gravity1-r8', checker.R8_RELEASE, True)
+
+    def test_reject_r8_with_old_release(self):
+        self.check_identity('8', 'linux-image-elementary-m4-gravity1-r8', checker.LEGACY_RELEASE, False)
+
+    def test_reject_r8_with_old_package_name(self):
+        self.check_identity('8', 'linux-image-elementary-m4-gravity1', checker.R8_RELEASE, False)
+
+if __name__ == '__main__':
+    unittest.main()
