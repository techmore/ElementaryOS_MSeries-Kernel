+++ b/src/kboot.c
@@ -5616,8 +5616,11 @@ int kboot_prepare_dt(void *fdt)
         bail("FDT: couldn't add reservation for the devtree\n");
 
     u64 image_end = (u64)_end;
-    /* Both post-M4 storage paths retain firmware buffers in the m1n1 heap. */
-    if (chip_id == T8140 ||
