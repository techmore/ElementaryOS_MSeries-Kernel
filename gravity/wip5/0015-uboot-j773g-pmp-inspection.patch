+  reserved=fdt_path_offset(fdt,"/reserved-memory");n=fdt_subnode_offset(fdt,reserved,names[i]);assert(!fdt_setprop_string(fdt,n,"status","okay"));
+  reserved=fdt_path_offset(fdt,"/reserved-memory");n=fdt_subnode_offset(fdt,reserved,names[i]);u32 phandle=(src?600:700)+i;assert(!fdt_setprop_u32(fdt,n,"phandle",phandle));refs[i]=cpu_to_fdt32(phandle);
+ }
+ g=fdt_path_offset(fdt,"/soc/gpu"); if(fault==7&&src) refs[0]=cpu_to_fdt32(9999);assert(!fdt_setprop(fdt,g,"memory-region",refs,sizeof(refs)));
+ g=fdt_path_offset(fdt,"/soc/gpu");assert(!fdt_setprop(fdt,g,"memory-region-names",name_list,sizeof(name_list)));
+ if(src){g=fdt_path_offset(fdt,"/soc/gpu");assert(!fdt_setprop_u32(fdt,g,"apple,g16-handoff-version",fault==2?2:1));
+  g=fdt_path_offset(fdt,"/soc/gpu");if(fault==6)fdt64_st(&vas[1],0);assert(!fdt_setprop(fdt,g,"apple,firmware-segment-vas",vas,sizeof(vas)));
+  g=fdt_path_offset(fdt,"/soc/gpu");assert(!fdt_setprop(fdt,g,"apple,firmware-segment-flags",flags,sizeof(flags)));}
+}
+int main(int argc,char **argv){assert(argc==3);for(int fault=0;fault<=2;fault++){
+ void *s=load(argv[1],128*1024),*d=load(argv[2],1024*1024);init(s,1,fault==1?3:0);init(d,0,0);
+ int pn=fdt_path_offset(s,"pmp");assert(!fdt_setprop_string(s,pn,"compatible","apple,t8132-pmp-v2"));
+ pn=fdt_path_offset(s,"pmp");assert(!fdt_setprop_string(s,pn,"status","disabled"));
+ pn=fdt_path_offset(s,"pmp");assert(!fdt_setprop_empty(s,pn,"apple,j773g-pmp-inspect-only"));
+ if(fault!=2){pn=fdt_path_offset(s,"pmp");assert(!fdt_setprop_u32(s,pn,"apple,tunable-soc-device",0x1234));}
+ pn=fdt_path_offset(d,"pmp");assert(!fdt_setprop_string(d,pn,"compatible","apple,t8132-pmp-v2"));
+ pn=fdt_path_offset(d,"pmp");assert(!fdt_setprop_string(d,pn,"status","disabled"));
+ pn=fdt_path_offset(d,"pmp");assert(!fdt_setprop_empty(d,pn,"apple,j773g-pmp-inspect-only"));
+ const char compat[]="apple,j773g\0apple,t8132";const char names[]="nvme\0nvmmu\0ans";
+ assert(!fdt_setprop(s,0,"compatible",compat,sizeof(compat)));assert(!fdt_setprop(d,0,"compatible",compat,sizeof(compat)));
+ int chosen=fdt_path_offset(d,"/chosen");assert(!fdt_setprop_string(d,chosen,"u-boot,j773g-dtb-source","0123456789012345678901234567890123456789"));
+ const char *aliases[]={"ans","ans-mbox","sart-ans"};const char *types[]={"apple,t8132-nvme-ans2","apple,asc-mailbox-v4","apple,t6000-sart"};
+ for(int i=0;i<3;i++){int n=fdt_path_offset(s,aliases[i]);assert(n>=0);assert(!fdt_setprop_string(s,n,"compatible",types[i]));n=fdt_path_offset(s,aliases[i]);assert(!fdt_setprop_string(s,n,"status","okay"));}
+ int n=fdt_path_offset(s,"ans");assert(!fdt_setprop(s,n,"reg-names",names,sizeof(names)));n=fdt_path_offset(d,"ans");assert(!fdt_setprop(d,n,"reg-names",names,sizeof(names)));
+ n=fdt_path_offset(s,"/reserved-memory/asc-firmware@900000000");if(n>=0)assert(!fdt_del_node(s,n));n=fdt_path_offset(s,"/reserved-memory/flash@900080000");if(n>=0)assert(!fdt_del_node(s,n));
+ while(fdt_num_mem_rsv(d)>0)assert(!fdt_del_mem_rsv(d,0));
