+# SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+"""Host-only check of the disabled J773g PMP metadata handoff."""
+import importlib.util
+from pathlib import Path
+import subprocess
+import tempfile
+
+repo = Path(__file__).resolve().parents[3]
+spec = importlib.util.spec_from_file_location('j713_tests', repo / 'test/py/tests/test_apple_j713_fdt.py')
+tests = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(tests)
+tests.HARNESS = tests.HARNESS.split('static void check_references')[0] + r'''
+int main(int argc, char **argv) {
+ assert(argc == 3);
+ for (int mode = 0; mode < 6; mode++) {
+  void *source = load(argv[1], 128 * 1024), *target = load(argv[2], 1024 * 1024);
+  int s = fdt_path_offset(source, "pmp"), d = fdt_path_offset(target, "pmp");
+  assert(s >= 0 && d >= 0);
+  assert(!fdt_setprop_string(source, s, "compatible", "apple,t8132-pmp-v2"));
+  s = fdt_path_offset(source, "pmp");
+  assert(!fdt_setprop_string(source, s, "status", mode == 4 ? "okay" : "disabled"));
+  s = fdt_path_offset(source, "pmp");
+  assert(!fdt_setprop_empty(source, s, "apple,j773g-pmp-inspect-only"));
+  s = fdt_path_offset(source, "pmp");
+  if (mode != 2) assert(!fdt_setprop_u32(source, s, "apple,tunable-soc-device", 0x1234));
+  s = fdt_path_offset(source, "pmp");
+  if (mode == 5) assert(!fdt_setprop(source, s, "apple,board-id", "bad", 3));
+  else assert(!fdt_setprop_u32(source, s, "apple,board-id", 42));
+  s = fdt_path_offset(source, "pmp");
+  assert(!fdt_setprop_u32(source, s, "apple,dram-vendor-id", 3));
+  d = fdt_path_offset(target, "pmp");
+  assert(!fdt_setprop_string(target, d, "compatible", "apple,t8132-pmp-v2"));
+  d = fdt_path_offset(target, "pmp");
+  assert(!fdt_setprop_string(target, d, "status", mode == 3 ? "okay" : "disabled"));
+  d = fdt_path_offset(target, "pmp");
+  if (mode != 1) assert(!fdt_setprop_empty(target, d, "apple,j773g-pmp-inspect-only"));
+  int ret = j773_pmp_inspection(target, source);
+  d = fdt_path_offset(target, "pmp");
+  int len; const char *status = fdt_getprop(target, d, "status", &len);
+  const fdt32_t *table = fdt_getprop(target, d, "apple,tunable-soc-device", &len);
+  if (mode == 0) {
+   assert(!ret && status && !strcmp(status, "disabled"));
+   assert(table && len == 4 && fdt32_to_cpu(*table) == 0x1234);
+  } else if (mode == 1) {
+   assert(!ret && status && !strcmp(status, "disabled") && !table);
+  } else {
+   assert(ret < 0 && !table);
+  }
+  free(source); free(target);
+ }
+ puts("PMP metadata import keeps mini disabled and rejects malformed inputs");
+ return 0;
+}
+'''
+
+
+def test_j773_pmp_inspect(tmp_path):
+    binary = tests.build_importer(tmp_path)
+    source = tests.compile_tree(tmp_path, 'source', tests.fixture_tree(True, graphics=False))
+    target = tests.compile_tree(tmp_path, 'target', tests.fixture_tree(False, graphics=False))
+    subprocess.run([str(binary), str(source), str(target)], check=True)
+
+
+if __name__ == '__main__':
+    with tempfile.TemporaryDirectory(prefix='j773g-pmp-import-') as tmp:
+        test_j773_pmp_inspect(Path(tmp))
