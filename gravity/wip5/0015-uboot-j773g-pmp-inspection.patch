+ g=fdt_path_offset(fdt,"/soc/gpu"); if(src||fault!=1)assert(!fdt_setprop_empty(fdt,g,"apple,j773g-gpu-handoff-draft"));
+ int aliases=fdt_path_offset(fdt,"/aliases"); assert(!fdt_setprop_string(fdt,aliases,"gpu","/soc/gpu"));
+ for(int i=0;i<6;i++){
