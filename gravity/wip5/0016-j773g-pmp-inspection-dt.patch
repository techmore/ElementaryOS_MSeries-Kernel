+/*
+ * Optional J773g PMP metadata inspection only. Requires the T8132 common
+ * PMP description and matching m1n1/U-Boot inspection handoff. It neither
+ * enables the PMP owner nor establishes GPU/display power ownership.
+ * Deliberately not included by the ordinary board DT.
+ */
+/ {
+	aliases {
+		pmp = &pmp;
+	};
+};
