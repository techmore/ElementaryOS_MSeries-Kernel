+			"bootstage = %d -> %d, rti state = %d -> %d\n",
+			old_bootstage, bootstage, old_rti_status, rti_status);
+		WRITE_ONCE(bcm4377->bootstage, bootstage);
+		WRITE_ONCE(bcm4377->rti_status, rti_status);
+		wake_up_all(&bcm4377->event);
+	}
