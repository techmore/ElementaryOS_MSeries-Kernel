+static void bcm4377_update_state(struct bcm4377_data *bcm4377,
+				 u32 bootstage, u32 rti_status)
+{
+	u32 old_bootstage = READ_ONCE(bcm4377->bootstage);
+	u32 old_rti_status = READ_ONCE(bcm4377->rti_status);
