--- /dev/null
+++ b/Documentation/ABI/testing/sysfs-driver-apple-dart
@@ -0,0 +1,24 @@
+# SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+What:		/sys/bus/platform/devices/<unit>.iommu/j713_radio_fault_state
+Date:		October 2026
+KernelVersion:	7.2
+Contact:	Eryk Wieliczko <eryk@wieliczko.ninja>
+Description:
+		Root-readable, passive fault-register snapshot for a bound Apple
+		DART using the J713 managed radio stream profile. Absent on other
+		DARTs. A read returns hexadecimal register values, decimal failure
+		state, and the following newline-separated fields:
+
+		version, managed, failed: DART version, owned stream bitmap, and
+		whether the driver's owned-stream quarantine has been triggered.
+		error_mask, error: inherited global error interrupt mask and error
+		register. A zero error mask is the generic driver's unmasked state.
+		error_streams[N], exceptions[N]: implemented stream-error and
+		per-stream exception summary words, including foreign streams.
+		sidN status, addr: exception status and address for each owned SID.
+
+		The snapshot can race hardware updates and IRQ acknowledgements;
+		it is not an atomic hardware snapshot or a claim of DMA quiescence.
+		Reading never clears or unmasks a fault, changes stream state,
+		starts DMA, or communicates with the Bluetooth controller.
diff --git a/Documentation/devicetree/bindings/iommu/apple,dart.yaml b/Documentation/devicetree/bindings/iommu/apple,dart.yaml
--- a/Documentation/devicetree/bindings/iommu/apple,dart.yaml
+++ b/Documentation/devicetree/bindings/iommu/apple,dart.yaml
@@ -41,6 +41,23 @@
               - apple,t8140-dart
               - apple,t8142-dart
           - const: apple,t8110-dart
+
+  apple,managed-sids:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    items:
+      - const: 1
+      - const: 2
+    description: >
+      J713 radio ordinary stream ownership profile. Only these inactive
+      normal streams and their exact-RID entries may be adopted by the OS.
+      Other streams and RID entries remain inherited. The documented static
+      SID16 bypass role may be initialized only from a disabled stream with
+      no valid root; an existing bypass remains unchanged. PIODMA and other
+      reserved roles are not modified. This does not authorize a controller
+      reset or takeover of active page tables. Both the radio DART and PCI
+      host describe the same two ordinary streams. Error reporting must
+      already be unmasked at admission; the OS preserves the inherited global
+      error-mask policy rather than changing it for these streams.
 
   reg:
     maxItems: 1
