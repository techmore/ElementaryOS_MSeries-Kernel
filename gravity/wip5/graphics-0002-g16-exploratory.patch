+/// The `asahi-g16/stats` debugfs file contents.
+fn stats_show(shared: &Arc<Shared>, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+    let state = shared.state.lock();
+    match state.as_deref() {
+        Some(firmware) => firmware.write_stats(f),
