+    pub(crate) claim_ns: u64,
+    /// Object writes: images, scene, barriers, InitBM, ring entries.
+    pub(crate) write_ns: u64,
+    /// Thresholds, queue WRITEs, channel records and doorbells.
+    pub(crate) post_ns: u64,
