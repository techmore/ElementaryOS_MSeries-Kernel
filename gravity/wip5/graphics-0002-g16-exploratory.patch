+    pub(crate) const OWN: usize = 0x24;
+    pub(crate) const TYPE: usize = 0x3c;
+    /// UUID of render predecessor waits.
+    pub(crate) const RENDER_WAIT_UUID: u32 = 0x3d420;
+}
