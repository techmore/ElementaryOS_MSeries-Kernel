+    /// reachable backing or aliases.
+    mappings: KVec<mmu::KernelMapping>,
+    /// A partially published allocation is retained and makes further publication fail-stop.
+    error: Option<Error>,
+    /// Host-window pages backed by objects.
+    pages: usize,
+}
+
+impl Objects {
+    pub(crate) fn new(
+        dev: &AsahiDrmDevice,
+        uat: Arc<mmu::Uat>,
+        window: uat::Window,
