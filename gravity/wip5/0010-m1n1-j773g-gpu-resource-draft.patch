--- a/src/kboot_gpu_m4.c
+++ b/src/kboot_gpu_m4.c
@@ -61,9 +61,24 @@ static int publish_gpu_m4(void *dt)
     int gpu = fdt_path_offset(dt, "gpu");
     if (gpu < 0)
         return 0; /* A framebuffer-only DT needs no GPU handoff. */
-    if (chip_id != T8132 || fdt_node_check_compatible(dt, 0, "apple,j713") ||
+    bool air = !fdt_node_check_compatible(dt, 0, "apple,j713");
+    bool mini = !fdt_node_check_compatible(dt, 0, "apple,j773g");
+    if (chip_id != T8132 || (!air && !mini) ||
         fdt_node_check_compatible(dt, gpu, "apple,agx-t8132"))
         return -1;
+    /* Mini resource publication is an explicit bring-up opt-in only. Keep
+     * the GPU disabled even when the handoff succeeds: board power, firmware
+     * identity, U-Boot import and the native driver still need qualification.
+     */
+    if (mini) {
+        int len;
+        const void *opt_in = fdt_getprop(dt, gpu, "apple,j773g-gpu-handoff-draft", &len);
+        if (!opt_in || len != 0)
+            return -1;
+        const char *status = fdt_getprop(dt, gpu, "status", &len);
+        if (!status || len != sizeof("disabled") || memcmp(status, "disabled", len))
+            return -1;
+    }
-
+
     /* A failed refresh must never leave a stale completed-handoff marker. */
     int ret = fdt_delprop(dt, gpu, "apple,g16-handoff-version");
@@ -151,7 +166,7 @@ static int publish_gpu_m4(void *dt)
         fdt_setprop(dt, gpu, "apple,firmware-segment-flags", flags, sizeof(flags)) ||
         fdt_setprop_u32(dt, gpu, "apple,g16-handoff-version", 1))
         return -1;
-    printf("FDT: GPU: published J713 G16 memory resources without starting the GPU\n");
+    printf("FDT: GPU: published T8132 G16 memory resources without starting the GPU\n");
     return 0;
 }
-
+
@@ -177,6 +192,6 @@ int dt_set_gpu_m4(void *dt)
     }
     if (fdt_setprop_string(dt, gpu, "status", "disabled") && fdt_nop_node(dt, gpu))
         return -1; /* A corrupt DT cannot safely describe the failed device. */
-    printf("FDT: GPU: unqualified J713 handoff, disabling native GPU\n");
+    printf("FDT: GPU: unqualified T8132 handoff, disabling native GPU\n");
     return 0;
 }
