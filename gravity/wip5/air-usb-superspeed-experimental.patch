+	/* Native settling time before the bounded 100 us calibration poll. */
+	udelay(15);
+	return readl_poll_timeout(atcphy->regs.core + AUS_COMMON_DIG_RCAL1, reg,
+				 reg & AUS_COMMON_DIG_RCAL1_ALL_CODES_DONE, 1, 100);
