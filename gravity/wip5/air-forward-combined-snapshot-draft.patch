+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only OR MIT
+"""Run production inherited PMGR admission against host register mocks."""
+import os
+from pathlib import Path
+import re
+import resource
+import shlex
+import subprocess
+import tempfile
+
+
+def function(source, name):
+    match = re.search(r"^static [^\n]*\b" + name + r"\(", source, re.M)
+    assert match, name
+    start = source.index("{", match.start())
+    depth, end = 1, start + 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[match.start():end] + "\n"
+
+
+def main():
+    root = Path(__file__).resolve().parents[5]
+    path = root / "drivers/pmdomain/apple/pmgr-pwrstate.c"
+    if not path.exists():
+        print("# SKIP: requires the matching kernel source tree")
+        return 4
+    source = path.read_text()
+    definitions = source[source.index("#define APPLE_PMGR_RESET"):source.index("static int apple_pmgr_ps_set")]
+    preamble = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
