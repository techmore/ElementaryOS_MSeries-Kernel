+static DEFINE_MUTEX(apple_soc_thermal_owner_lock);
+
+static s32 apple_soc_cpufreq_unmanaged_max(struct cpufreq_policy *policy)
+{
+	struct apple_cpu_priv *priv = policy->driver_data;
+	struct cpufreq_frequency_table *p;
+	unsigned int cap = 0;
