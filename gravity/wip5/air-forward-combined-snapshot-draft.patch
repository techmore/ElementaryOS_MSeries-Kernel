+	pmp: pmp { phandle = <1>; };
+	soc: soc {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		pmgr: power-management@380700000 {
+			#address-cells = <1>;
+			#size-cells = <1>;
+			reg = <0x3 0x80700000 0 0x14000>;
+		};
+
+		pmgr_mini: power-management@388280000 {
+			#address-cells = <1>;
+			#size-cells = <1>;
+			reg = <0x3 0x88280000 0 0x4000>;
+		};
+	};
+};
+
+#include "../../../arch/arm64/boot/dts/apple/t8132-pmgr.dtsi"
+#include "../../../arch/arm64/boot/dts/apple/t8132-j713-pmgr.dtsi"
+#include "../../../arch/arm64/boot/dts/apple/t8132-memory.dtsi"
+
+&mcc {
+	apple,boot-dma-devices = <&pmp>;
+};
+
+&pmc {
+	apple,static-voters = <3>;
+};
diff --git a/drivers/soc/apple/t8132-platform-handoff.c b/drivers/soc/apple/t8132-platform-handoff.c
new file mode 100644
--- /dev/null
+++ b/drivers/soc/apple/t8132-platform-handoff.c
@@ -0,0 +1,279 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/* Supply missing platform descriptions for the original J713 loader ABI.
+ * Keep the shared m1n1 payload usable by the stable kernel. Hardware control
+ * remains in the ordinary MCC, PMC and CLPC drivers, with one DTS data source.
+ * J713 PMGR ownership/status also comes from its board DTS, before any domain
+ * registers can be accessed. Native descriptions take precedence.
+ */
+#include <linux/init.h>
+#include <linux/libfdt.h>
+#include <linux/of.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+
+extern const u8 __dtb_t8132_platform_data_begin[];
+
+static int __init t8132_copy_property(struct of_changeset *cs,
+				      struct device_node *node,
+				      const char *name, const void *value,
+				      int len)
+{
+	struct property *prop;
+	int ret;
+
+	prop = kzalloc_obj(*prop);
+	if (!prop)
+		return -ENOMEM;
+	prop->name = kstrdup(name, GFP_KERNEL);
+	prop->value = kmemdup(value, len, GFP_KERNEL);
+	prop->length = len;
+	if (!prop->name || !prop->value) {
+		ret = -ENOMEM;
+		goto fail;
+	}
+	of_property_set_flag(prop, OF_DYNAMIC);
+	ret = cs ? of_changeset_add_property(cs, node, prop) :
+		   of_add_property(node, prop);
+	if (!ret) {
+		if (cs) {
+			prop->next = node->deadprops;
+			node->deadprops = prop;
+		}
+		return 0;
+	}
+fail:
+	kfree(prop->name);
+	kfree(prop->value);
+	kfree(prop);
+	return ret;
+}
+
+static int __init t8132_copy_node(struct of_changeset *cs,
+				  struct device_node *parent, int offset,
+				  phandle pmp, phandle gfx, unsigned int *added)
+{
+	const void *data = __dtb_t8132_platform_data_begin;
+	const char *name = fdt_get_name(data, offset, NULL);
+	char *base;
+	struct device_node *node;
+	int prop_offset, child, len, ret = 0;
+
+	/* Compare the unit address too; of_get_child_by_name() omits it. */
+	for_each_child_of_node_scoped(parent, child_node)
+		if (!strcmp(kbasename(child_node->full_name), name))
+			return 0;
+	node = of_changeset_create_node(cs, parent, name);
+	if (!node)
+		return -ENOMEM;
+	/* The attach action reads name before queued properties are applied. */
+	base = kstrndup(name, strcspn(name, "@"), GFP_KERNEL);
+	if (!base) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	ret = t8132_copy_property(NULL, node, "name", base, strlen(base) + 1);
+	kfree(base);
+	if (ret)
+		goto out;
+	fdt_for_each_property_offset(prop_offset, data, offset) {
+		const struct fdt_property *prop =
+			fdt_get_property_by_offset(data, prop_offset, &len);
+
+		if (!prop) {
+			ret = -EINVAL;
+			goto out;
+		}
+		name = fdt_string(data, fdt32_to_cpu(prop->nameoff));
+		if (!strcmp(name, "status") || !strcmp(name, "phandle") ||
+		    !strcmp(name, "name"))
+			continue;
+		if (!strcmp(name, "apple,pmp") ||
+		    !strcmp(name, "apple,boot-dma-devices"))
+			ret = of_changeset_add_prop_u32(cs, node, name, pmp);
+		else if (!strcmp(name, "apple,gpu-power-state"))
+			ret = of_changeset_add_prop_u32(cs, node, name, gfx);
+		else
+			ret = t8132_copy_property(cs, node, name, prop->data,
+						  len);
+		if (ret)
+			goto out;
+	}
+	ret = of_changeset_add_prop_string(cs, node, "status", "okay");
+	if (ret)
+		goto out;
+	fdt_for_each_subnode(child, data, offset) {
+		ret = t8132_copy_node(cs, node, child, pmp, gfx, added);
+		if (ret)
+			break;
+	}
+	if (!ret)
+		(*added)++;
+out:
+	of_node_put(node);
+	return ret;
+}
+
+/* Resolve the OF ancestry: full_name is a component, not an absolute path. */
+static int __init t8132_fdt_node_offset(const void *data,
+				      const struct device_node *node)
+{
+	int parent;
+
+	if (!node || !node->full_name)
+		return -FDT_ERR_BADPATH;
+	if (of_node_is_root(node))
+		return *kbasename(node->full_name) ? -FDT_ERR_BADPATH : 0;
+
+	parent = t8132_fdt_node_offset(data, node->parent);
+	if (parent < 0)
+		return parent;
+	return fdt_subnode_offset(data, parent, kbasename(node->full_name));
+}
+
+/* Apply only board availability/ownership, never imported register values. */
+static int __init t8132_pmgr_policy(struct of_changeset *cs, unsigned int *changed)
+{
+	const void *data = __dtb_t8132_platform_data_begin;
+	const char * const ownership[] = { "apple,firmware-owned", "apple,t8132-inherited-on" };
+	struct device_node *pmgr;
+	int ret;
+
+	for_each_compatible_node(pmgr, NULL, "apple,t8132-pmgr") {
+		int parent = t8132_fdt_node_offset(data, pmgr);
+
+		if (parent < 0) {
+			pr_err("t8132-platform-handoff: cannot resolve PMGR policy for %pOF: %d\n",
+			       pmgr, parent);
+			ret = -EINVAL;
+			goto put_pmgr;
+		}
+		for_each_child_of_node_scoped(pmgr, node) {
+			const char *status, *live;
+			int offset, len;
+
+			if (!of_device_is_compatible(node, "apple,t8132-pmgr-pwrstate"))
+				continue;
+			offset = parent < 0 ? parent :
+				fdt_subnode_offset(data, parent, kbasename(node->full_name));
+			status = offset < 0 ? NULL : fdt_getprop(data, offset, "status", &len);
+			/* Unknown legacy domains stay inaccessible, rather than being probed. */
+			if (!status)
+				status = "disabled";
+			if (of_property_read_string(node, "status", &live)) {
+				ret = of_changeset_add_prop_string(cs, node, "status", status);
+				if (ret)
+					goto put_pmgr;
+				(*changed)++;
+			} else if (!strcmp(status, "disabled") && strcmp(live, status)) {
+				ret = of_changeset_update_prop_string(cs, node, "status", status);
+				if (ret)
+					goto put_pmgr;
+				(*changed)++;
+			}
+			for (unsigned int i = 0; i < ARRAY_SIZE(ownership); i++) {
+				if (offset < 0 || !fdt_getprop(data, offset, ownership[i], NULL) ||
+				    of_property_present(node, ownership[i]))
+					continue;
+				ret = of_changeset_add_prop_bool(cs, node, ownership[i]);
+				if (ret)
+					goto put_pmgr;
+				(*changed)++;
+			}
+		}
+	}
+	return 0;
+put_pmgr:
+	of_node_put(pmgr);
+	return ret;
+}
+
+/* Follow the shared DTS reference instead of interpreting a magic PMGR offset. */
+static struct device_node *__init t8132_find_gfx(void)
+{
+	const void *data = __dtb_t8132_platform_data_begin;
+	const fdt32_t *prop;
+	char path[256];
+	int offset, len;
+
+	offset = fdt_node_offset_by_compatible(data, -1, "apple,t8132-clpc");
+	if (offset < 0)
+		return NULL;
+	prop = fdt_getprop(data, offset, "apple,gpu-power-state", &len);
+	if (!prop || len != sizeof(*prop))
+		return NULL;
+	offset = fdt_node_offset_by_phandle(data, fdt32_to_cpu(*prop));
+	if (offset < 0 || fdt_get_path(data, offset, path, sizeof(path)))
+		return NULL;
+	return of_find_node_by_path(path);
+}
+
+static int __init t8132_platform_handoff(void)
+{
+	const void *data = __dtb_t8132_platform_data_begin;
+	struct device_node *soc, *pmp = NULL, *gpu = NULL, *gfx = NULL;
+	struct of_changeset *cs;
+	unsigned int added = 0, changed = 0;
+	int root, node, ret;
+
+	if (!of_machine_is_compatible("apple,j713") ||
+	    !of_machine_is_compatible("apple,t8132"))
+		return 0;
+	if (fdt_check_header(data))
+		return -EINVAL;
+	soc = of_find_node_by_path("/soc");
+	if (!soc)
+		return -ENODEV;
+	cs = kzalloc_obj(*cs);
+	if (!cs) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	of_changeset_init(cs);
+	ret = t8132_pmgr_policy(cs, &changed);
+	if (ret)
+		goto destroy;
+
+	pmp = of_find_compatible_node(NULL, NULL, "apple,t8132-pmp-v2");
+	gpu = of_find_compatible_node(NULL, NULL, "apple,agx-t8132");
+	gfx = gpu ? of_parse_phandle(gpu, "power-domains", 0) : NULL;
+	if (!gfx)
+		gfx = t8132_find_gfx();
+	if (!pmp || !gfx || !pmp->phandle || !gfx->phandle) {
+		pr_warn("t8132-platform-handoff: memory compatibility requires PMP/GFX providers\n");
+		goto apply;
+	}
+	root = fdt_path_offset(data, "/soc");
+	if (root < 0) {
+		ret = -EINVAL;
+		goto destroy;
+	}
+	fdt_for_each_subnode(node, data, root) {
+		/* The embedded PMGR nodes contain policy for existing providers only. */
+		if (!fdt_getprop(data, node, "compatible", NULL))
+			continue;
+		ret = t8132_copy_node(cs, soc, node, pmp->phandle,
+				      gfx->phandle, &added);
+		if (ret)
+			goto destroy;
+	}
+apply:
+	ret = of_changeset_apply(cs);
+destroy:
+	if (ret) {
+		of_changeset_destroy(cs);
+		kfree(cs);
+	} else if (added || changed) {
+		/* The applied node/property storage lives until reboot. */
+		pr_info("t8132-platform-handoff: supplied %u platform nodes, %u PMGR policy properties\n",
+			added, changed);
+	}
+out:
+	of_node_put(gfx);
+	of_node_put(gpu);
+	of_node_put(pmp);
+	of_node_put(soc);
+	return ret;
+}
+
+/* Like the T6030 handoff, before of_platform_default_populate(). */
+arch_initcall(t8132_platform_handoff);
diff --git a/drivers/soc/apple/t8132-platform-test.c b/drivers/soc/apple/t8132-platform-test.c
new file mode 100644
--- /dev/null
+++ b/drivers/soc/apple/t8132-platform-test.c
@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+#include <kunit/test.h>
+#include <linux/of.h>
+
+static void t8132_test_legacy_descriptions(struct kunit *test)
+{
+	struct device_node *mcc __free(device_node) = NULL;
+	struct device_node *pmc __free(device_node) = NULL;
+	struct device_node *pmp __free(device_node) = NULL;
+	struct device_node *gpu __free(device_node) = NULL;
+	struct device_node *gfx __free(device_node) = NULL;
+	struct device_node *clpc __free(device_node) = NULL;
+	struct device_node *provider;
+	u32 reg[8], agent;
+	const char *status;
+
+	if (!of_machine_is_compatible("apple,j713")) {
+		kunit_skip(test, "requires the J713 legacy-loader fixture");
+		return;
+	}
+	mcc = of_find_compatible_node(NULL, NULL, "apple,t8132-mcc");
+	pmc = of_find_compatible_node(NULL, NULL, "apple,t8132-pmc");
+	pmp = of_find_node_by_path("pmp");
+	gpu = of_find_compatible_node(NULL, NULL, "apple,agx-t8132");
+	KUNIT_ASSERT_NOT_NULL(test, mcc);
+	KUNIT_ASSERT_NOT_NULL(test, pmc);
+	KUNIT_ASSERT_NOT_NULL(test, pmp);
+	KUNIT_EXPECT_TRUE(test, of_device_is_available(pmc));
+	if (of_device_is_compatible(mcc, "kunit,existing")) {
+		KUNIT_EXPECT_FALSE(test, of_device_is_available(mcc));
+		KUNIT_ASSERT_EQ(test, of_property_read_string(mcc, "status", &status), 0);
+		KUNIT_EXPECT_STREQ(test, status, "disabled");
+		KUNIT_EXPECT_FALSE(test, of_property_present(mcc, "apple,boot-dma-devices"));
+		KUNIT_EXPECT_EQ(test, of_get_child_count(mcc->parent), 5);
+	} else {
+		KUNIT_EXPECT_TRUE(test, of_device_is_available(mcc));
+		KUNIT_EXPECT_STREQ(test, mcc->name, "memory-controller");
+		KUNIT_ASSERT_EQ(test, of_property_read_u32_array(mcc, "reg", reg, 8), 0);
+		KUNIT_EXPECT_EQ(test, reg[0], 2U);
+		KUNIT_EXPECT_EQ(test, reg[1], 0x20000000U);
+		KUNIT_EXPECT_EQ(test, reg[3], 0x1c1c04U);
+		provider = of_parse_phandle(mcc, "apple,boot-dma-devices", 0);
+		KUNIT_EXPECT_PTR_EQ(test, provider, pmp);
+		of_node_put(provider);
+	}
+	provider = of_parse_phandle(pmc, "apple,pmp", 0);
+	KUNIT_EXPECT_PTR_EQ(test, provider, pmp);
+	of_node_put(provider);
+	KUNIT_ASSERT_EQ(
+		test, of_property_read_u32(pmc, "apple,static-voters", &agent),
+		0);
+	KUNIT_EXPECT_EQ(test, agent, 3U);
+	clpc = of_get_child_by_name(pmc, "performance-controller");
+	KUNIT_ASSERT_NOT_NULL(test, clpc);
+	gfx = of_parse_phandle(clpc, "apple,gpu-power-state", 0);
+	KUNIT_ASSERT_NOT_NULL(test, gfx);
+	if (gpu) {
+		provider = of_parse_phandle(gpu, "power-domains", 0);
+		KUNIT_EXPECT_PTR_EQ(test, provider, gfx);
+		of_node_put(provider);
+	} else {
+		KUNIT_EXPECT_TRUE(test,
+			of_device_is_compatible(gfx, "apple,t8132-pmgr-pwrstate"));
+		KUNIT_ASSERT_EQ(test, of_property_read_u32(gfx, "reg", &agent), 0);
+		KUNIT_EXPECT_EQ(test, agent, 0x250U);
+	}
+}
+
+static struct kunit_case t8132_platform_cases[] = {
+	KUNIT_CASE(t8132_test_legacy_descriptions),
+	{},
+};
+
+static struct kunit_suite t8132_platform_suite = {
+	.name = "apple-t8132-platform",
+	.test_cases = t8132_platform_cases,
+};
+
+kunit_test_suite(t8132_platform_suite);
+MODULE_LICENSE("Dual MIT/GPL");
