+    for chip in [4377, 4378, 4387, 4388]:
+        entry = definition(source, f'\t[BCM{chip}] = {{')
+        offset = re.search(r'\.bar2_offset\s*=\s*(\w+)', entry)
+        high = re.search(r'\.bar2_context_addr_hi\s*=\s*(\w+)', entry)
