+&dwc3_0 {
+	status = "okay";
+	dr_mode = "host";
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@0 {
+			reg = <0>;
+			dwc3_0_hs: endpoint {
+				remote-endpoint = <&typec0_connector_hs>;
+			};
+		};
+	};
+};
+
+&atcphy1 {
+	status = "okay";
