diff --git a/Documentation/devicetree/bindings/soc/apple/apple,t8140-mcc.yaml b/Documentation/devicetree/bindings/soc/apple/apple,t8140-mcc.yaml
--- a/Documentation/devicetree/bindings/soc/apple/apple,t8140-mcc.yaml
+++ b/Documentation/devicetree/bindings/soc/apple/apple,t8140-mcc.yaml
@@ -4,23 +4,25 @@
 $id: http://devicetree.org/schemas/soc/apple/apple,t8140-mcc.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Apple T8140 memory cache controller
+title: Apple memory cache controller
 
 maintainers:
   - Ryan Murray <ryan@aurorasilicon.org>
 
 description:
-  The memory cache controller of the Apple T8140 SoC holds the system level
-  cache in front of DRAM, split into planes. The boot firmware enables and
-  powers the cache ways of every plane but leaves allocation disabled, so the
-  cache holds no data until the operating system allows allocation.
+  The memory cache controller holds the system level cache in front of DRAM.
+  T8140 exposes per-plane allocation and flush controls. T8132 instead has
+  two apertures with two planes each and a multicast cache-enable register;
+  its enabled cache is retained until a dirty-data drain is qualified.
 
 properties:
   compatible:
-    const: apple,t8140-mcc
+    enum:
+      - apple,t8132-mcc
+      - apple,t8140-mcc
 
   reg:
-    description: The register block of each cache plane.
+    description: Per-plane blocks on T8140, or the two multicast apertures on T8132.
     minItems: 1
     maxItems: 8
 
