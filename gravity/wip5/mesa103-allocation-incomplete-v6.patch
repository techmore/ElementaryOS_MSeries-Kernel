+bool
+agx_pool_try_alloc_aligned(struct agx_pool *pool, size_t sz,
+                           unsigned alignment, struct agx_ptr *out)
+{
+   assert(alignment == util_next_power_of_two(alignment));
+   struct agx_bo *bo = pool->transient_bo;
+   unsigned offset = ALIGN_POT(pool->transient_offset, alignment);
+   bool new_bo = !bo || offset >= POOL_SLAB_SIZE ||
+                 sz >= POOL_SLAB_SIZE - offset;
+
+   if (new_bo) {
+      bo = agx_bo_create(pool->dev, ALIGN_POT(MAX2(POOL_SLAB_SIZE, sz), 16384),
+                         0, pool->create_flags, pool->label);
+      if (!bo)
+         return false;
+      offset = 0;
+   }
+
+   uint8_t *map = agx_bo_map(bo);
+   if (!map) {
+      if (new_bo)
+         agx_bo_unreference(pool->dev, bo);
+      return false;
+   }
+
+   if (new_bo) {
+      struct agx_bo **entry = util_dynarray_grow(&pool->bos, struct agx_bo *, 1);
+      if (!entry) {
+         agx_bo_unreference(pool->dev, bo);
+         return false;
+      }
+      *entry = bo;
+      pool->transient_bo = bo;
+   }
+   pool->transient_offset = offset + sz;
+   *out = (struct agx_ptr){.cpu = map + offset, .gpu = bo->va->addr + offset};
+   return true;
+}
