+	ret = fdt_delprop(dst, dn, comparison_name);
+	if (ret && ret != -FDT_ERR_NOTFOUND)
+		return;
+	dn = j713_alias_node(dst, "gpu");
+	ret = fdt_delprop(dst, dn, size_name);
+	if (ret && ret != -FDT_ERR_NOTFOUND)
+		return;
