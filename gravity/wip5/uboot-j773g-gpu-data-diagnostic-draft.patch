+/* Import only the size and comparison; never transfer an additional address.
+ * Diagnostics are optional and have their own transaction inside the outer
+ * import transaction, so absence, malformed data or ENOSPC cannot block it.
+ */
+static void j773_gpu_diagnostic(void *dst, const void *src, int sn)
+{
+	const char *const comparison_name = "apple,j773g-gpu-data-comparison";
+	const char *const size_name = "apple,j773g-sgx-data-size";
