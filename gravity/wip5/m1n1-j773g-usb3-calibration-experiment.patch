+/* Validate the J773g fixed-hub description before exporting banked values. */
+static bool dt_j773g_fixed_usb3_valid(const void *dt, int adt_node, int fdt_node, int port)
+{
+    static const char *const banks[] = {"usb2phy", "pipehandler", "core", "axi2af",
+                                        "lioa", "fabric", "common-config"};
+
+    if (chip_id != T8132 || fdt_node_check_compatible(dt, 0, "apple,j773g") || port != 2 ||
+        !fdt_getprop(dt, fdt_node, "apple,fixed-usb3", NULL) ||
+        fdt_node_check_compatible(dt, fdt_node, "apple,t8132-atcphy") ||
+        !adt_is_compatible_at(adt, adt_node, "atc-phy,t8132", 0) ||
+        fdt_stringlist_count(dt, fdt_node, "reg-names") != (int)ARRAY_SIZE(banks))
+        return false;
+    for (size_t i = 0; i < ARRAY_SIZE(banks); i++)
+        if (fdt_stringlist_search(dt, fdt_node, "reg-names", banks[i]) != (int)i)
+            return false;
+    return true;
+}
