--- a/arch/arm64/boot/dts/apple/t8132-j773g.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j773g.dts
@@ -96,3 +96,5 @@
 &smc_mbox {
 	status = "okay";
 };
+
+#include "t8132-j773g-ethernet-draft.dtsi"
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t8132-j773g-ethernet-draft.dtsi
@@ -0,0 +1,69 @@
+#include <dt-bindings/gpio/gpio.h>
+/* Experimental J773g Ethernet topology; all new devices stay disabled. */
+&pinctrl_ap {
+	j773g_pcie_pins: j773g-pcie-pins {
+		pinmux = <0x100a0 0x100a1 0x100a2>;
+	};
+};
+
+&soc {
+	j773g_dart_apcie2: iommu@492000000 {
+		compatible = "apple,t8132-dart", "apple,t8110-dart";
+		reg = <0x4 0x92000000 0x0 0x4000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 1250 IRQ_TYPE_LEVEL_HIGH>;
+		power-domains = <&ps_apcie_gp>;
+		#iommu-cells = <1>;
+		status = "disabled";
+	};
+};
+
+&pcie0 {
+	compatible = "apple,t8132-pcie", "apple,t6020-pcie";
+	reg = <0x1c 0xb0000000 0x0 0x1000000>,
+	      <0x4 0x94000000 0x0 0x4000>,
+	      <0x4 0x90028000 0x0 0x4000>,
+	      <0x4 0x91028000 0x0 0x4000>,
+	      <0x4 0x92028000 0x0 0x4000>,
+	      <0x4 0x97020000 0x0 0x4000>,
+	      <0x4 0x97024000 0x0 0x4000>,
+	      <0x4 0x97028000 0x0 0x4000>;
+	reg-names = "config", "rc", "port0", "port1", "port2", "phy0", "phy1", "phy2";
+	interrupts = <AIC_IRQ 1231 IRQ_TYPE_LEVEL_HIGH>,
+		     <AIC_IRQ 1240 IRQ_TYPE_LEVEL_HIGH>,
+		     <AIC_IRQ 1249 IRQ_TYPE_LEVEL_HIGH>;
+	power-domains = <&ps_apcie_phy_sw>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&j773g_pcie_pins>;
+	bus-range = <0 3>;
+	iommu-map = <0x200 &j773g_dart_apcie2 1 1>;
+	iommu-map-mask = <0xff00>;
+	status = "disabled";
+
+	pci@0,0 { status = "disabled"; };
+
+	j773g_port02: pci@2,0 {
+		compatible = "pciclass,0604";
+		device_type = "pci";
+		reg = <0x1000 0 0 0 0>;
+		bus-range = <2 2>;
+		reset-gpios = <&pinctrl_ap 165 GPIO_ACTIVE_LOW>;
+		#address-cells = <3>;
+		#size-cells = <2>;
+		ranges;
+		interrupt-controller;
+		#interrupt-cells = <1>;
+		interrupt-map-mask = <0 0 0 7>;
+		interrupt-map = <0 0 0 1 &j773g_port02 0 0 0 0>,
+				<0 0 0 2 &j773g_port02 0 0 0 1>,
+				<0 0 0 3 &j773g_port02 0 0 0 2>,
+				<0 0 0 4 &j773g_port02 0 0 0 3>;
+		status = "disabled";
+
+		j773g_ethernet: ethernet@0,0 {
+			reg = <0x20000 0 0 0 0>;
+			/* Per-machine MAC must be provided by a qualified handoff. */
+			status = "disabled";
+		};
+	};
+};
