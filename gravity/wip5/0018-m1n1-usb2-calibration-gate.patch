+++ b/tests/python/test_j773g_usb2_calibration_skip.py
@@ -0,0 +1,56 @@
+# SPDX-License-Identifier: GPL-2.0-only OR MIT
+"""Host-only check of the mini's two-bank USB2 calibration gate."""
+from pathlib import Path
+import subprocess
+import tempfile
+
+
+def test_j773g_usb2_calibration_gate(tmp_path):
+    repo = Path(__file__).resolve().parents[2]
+    source = (repo / 'src/kboot_atc.c').read_text()
+    start = source.index('static bool j773g_usb2_only_phy(')
+    end = source.index('static void dt_copy_atc_tunables(', start)
+    helper = source[start:end]
+    harness = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include "libfdt.h"
+#define T8132 0x8132
+static unsigned chip_id = T8132;
+''' + helper + r'''
+int main(void) {
+ for (int mode=0; mode<7; mode++) {
+  char dt[8192]; assert(!fdt_create_empty_tree(dt,sizeof(dt)));
+  assert(!fdt_setprop_string(dt,0,"compatible",mode==1?"apple,j713":"apple,j773g"));
+  int node=fdt_add_subnode(dt,0,"phy"); assert(node>=0);
+  assert(!fdt_setprop_string(dt,node,"compatible",mode==2?"apple,t8122-atcphy":"apple,t8132-atcphy"));
+  node=fdt_path_offset(dt,"/phy");
+  const char valid[]="usb2phy\0pipehandler";
+  const char reversed[]="pipehandler\0usb2phy";
+  const char extra[]="usb2phy\0pipehandler\0core";
+  if(mode!=5) assert(!fdt_setprop(dt,node,"reg-names",mode==3?reversed:mode==4?extra:valid,
+                                  mode==3?sizeof(reversed):mode==4?sizeof(extra):sizeof(valid)));
+  chip_id=mode==6?0x8140:T8132; node=fdt_path_offset(dt,"/phy");
+  assert(j773g_usb2_only_phy(dt,node)==(mode==0));
+ }
+ puts("J773g two-bank USB2 gate and six negative profiles PASS");
+ return 0;
+}
+'''
+    file = tmp_path / 'usb2.c'
+    file.write_text(harness)
+    libfdt = repo / 'src/libfdt'
+    names = ['fdt', 'fdt_ro', 'fdt_rw', 'fdt_sw', 'fdt_wip', 'fdt_empty_tree',
+             'fdt_check', 'fdt_strerror', 'fdt_addresses']
+    binary = tmp_path / 'usb2'
+    subprocess.run(['cc', '-D_GNU_SOURCE', '-std=gnu11', '-Wall', '-Wextra', '-Werror',
+                    '-I', str(libfdt), str(file), *[str(libfdt / (n + '.c')) for n in names],
+                    '-o', str(binary)], check=True)
+    subprocess.run([str(binary)], check=True)
+
+
+if __name__ == '__main__':
+    with tempfile.TemporaryDirectory(prefix='j773g-usb2-') as tmp:
+        test_j773g_usb2_calibration_gate(Path(tmp))
