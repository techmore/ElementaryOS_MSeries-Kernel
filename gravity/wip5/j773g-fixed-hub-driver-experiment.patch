diff --git a/tools/testing/selftests/drivers/apple/j773g-fixed-hub.py b/tools/testing/selftests/drivers/apple/j773g-fixed-hub.py
new file mode 100755
--- /dev/null
+++ b/tools/testing/selftests/drivers/apple/j773g-fixed-hub.py
@@ -0,0 +1,58 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only OR MIT
+"""Exercise the production fixed-hub route with host-side PHY stubs."""
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[5]
+src = (root / 'drivers/phy/apple/atc.c').read_text()
+m = re.search(r'^static int atcphy_usb3_route\(', src, re.M)
+assert m
+start = m.start()
+brace = src.index('{', start)
+depth = 1
+end = brace + 1
+while depth:
+    depth += (src[end] == '{') - (src[end] == '}')
+    end += 1
+fn = src[start:end]
+pre = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <errno.h>
+#include <stdio.h>
+#define lockdep_assert_held(x) ((void)0)
+enum { APPLE_ATCPHY_MODE_OFF, APPLE_ATCPHY_MODE_USB2, APPLE_ATCPHY_MODE_USB3, APPLE_ATCPHY_MODE_USB3_DP };
+struct apple_atcphy { bool fixed_usb3, mode_dirty, t8103_dummy_pending, t8103_usb3_workaround;
+    bool t8103_usb3_retry, dp_only, ss_tunables, pipe_pending; int mode, typec_mode, pipe_state, lock; };
+struct { int pipehandler_state; } atcphy_modes[] = {{0},{0},{1},{1}};
+static int starts, routes, failure;
+static int atcphy_configure(struct apple_atcphy *a, int mode) {
+    starts++; if (failure) return -EIO; a->mode = mode; return 0;
+}
+static int atcphy_park_live_t8103_pipehandler(struct apple_atcphy *a) { (void)a; return 0; }
+static int atcphy_park_pipehandler(struct apple_atcphy *a, bool stopped) { (void)stopped; a->pipe_pending = false; return 0; }
+static int atcphy_configure_pipehandler(struct apple_atcphy *a, bool host) { (void)host; routes++; a->pipe_state = 1; return 0; }
+'''
+test = r'''
+int main(void) {
+    struct apple_atcphy a = {.fixed_usb3 = true, .mode = APPLE_ATCPHY_MODE_USB2, .ss_tunables = true};
+    assert(!atcphy_usb3_route(&a, true)); assert(starts == 1 && routes == 1 && a.mode == APPLE_ATCPHY_MODE_USB3);
+    assert(!atcphy_usb3_route(&a, true)); assert(starts == 1 && routes == 1);
+    a.mode = APPLE_ATCPHY_MODE_USB2; a.pipe_state = 0; failure = 1; routes = 0;
+    assert(atcphy_usb3_route(&a, true) == -EIO && routes == 0);
+    failure = 0; a.mode_dirty = true; starts = 0;
+    assert(atcphy_usb3_route(&a, true) == -EBUSY && starts == 0);
+    a.mode_dirty = false; a.fixed_usb3 = false; a.mode = APPLE_ATCPHY_MODE_USB2; a.pipe_state = 0;
+    assert(!atcphy_usb3_route(&a, true) && starts == 0);
+    puts("fixed hub: admission, idempotence, failures and non-hub isolation passed");
+}
+'''
+with tempfile.TemporaryDirectory() as d:
+    c = Path(d) / 'test.c'
+    c.write_text(pre + fn + '\n' + test)
+    exe = Path(d) / 'test'
+    subprocess.run(['cc', '-std=c11', '-Wall', '-Wextra', '-Werror', str(c), '-o', str(exe)], check=True)
+    subprocess.run([str(exe)], check=True)
