+/* Inspection only. Run before Air-specific resource admission so a mini can
+ * report a differing DATA handoff even when another admission check fails.
+ * Never publish an address or use this comparison to admit the GPU. */
+static void inspect_mini_gpu_data(void *dt, int sgx, int asc)
+{
+    struct gpu_m4_range sgx_data;
+    const char *comparison = "unavailable";
+    u32 len;
+    const char *names = adt_getprop(adt, asc, "segment-names", &len);
+    bool valid_names = names && len == sizeof("__TEXT;__DATA") &&
+                       !memcmp(names, "__TEXT;__DATA", len);
+    const struct adt_segment_ranges *segments = adt_getprop(adt, asc, "segment-ranges", &len);
+    bool valid_segments = segments && len == 2 * sizeof(*segments);
+    bool available = valid_names && valid_segments && !read_range(sgx, "gfx-data", &sgx_data);
+    if (available) {
+        struct gpu_m4_range asc_data = {segments[1].phys, segments[1].size};
+        available = valid_range(asc_data);
+        if (available)
+            comparison = sgx_data.base == asc_data.base && sgx_data.size == asc_data.size ?
+                             "match" : "mismatch";
+    }
+    int gpu = fdt_path_offset(dt, "gpu");
+    if (gpu < 0)
+        return;
+    if (available) {
+        fdt64_t size = cpu_to_fdt64(sgx_data.size);
+        if (fdt_setprop(dt, gpu, "apple,j773g-sgx-data-size", &size, sizeof(size)))
+            return;
+    }
+    gpu = fdt_path_offset(dt, "gpu");
+    if (gpu >= 0 && fdt_setprop_string(dt, gpu, "apple,j773g-gpu-data-comparison", comparison))
+        printf("FDT: GPU: data-range diagnostic unavailable\n");
+}
