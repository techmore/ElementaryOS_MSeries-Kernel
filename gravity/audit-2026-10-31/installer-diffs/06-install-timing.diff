+# installer's ESP timing log into /var/log/omarchy/install-timing.jsonl on first
+# boot and appends the Linux milestones. The desktop milestone is the user
+# session's (`exec-once = omarchy-install-timing desktop`); the `/var/log/omarchy`
+# directory must be writable by the owner for it (or log via the user journal).
+stage_install_timing() {
+  install -Dm0755 "$ROOT/builder/install-timing/omarchy-install-timing" "$target/usr/local/bin/omarchy-install-timing"
+  install -Dm0644 "$ROOT/builder/install-timing/omarchy-install-timing.service" \
+    "$target/etc/systemd/system/omarchy-install-timing.service"
+  mkdir -p "$target/etc/systemd/system/multi-user.target.wants"
+  ln -sf ../omarchy-install-timing.service "$target/etc/systemd/system/multi-user.target.wants/"
+  install -d -m 1777 "$target/var/log/omarchy"
+}
