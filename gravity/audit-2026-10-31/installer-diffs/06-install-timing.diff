diff --git a/image-builder/builder/install-timing/omarchy-install-timing b/image-builder/builder/install-timing/omarchy-install-timing
new file mode 100644
index 0000000..357942a
--- /dev/null
+++ b/image-builder/builder/install-timing/omarchy-install-timing
@@ -0,0 +1,29 @@
+#!/bin/bash
+# Record the Linux half of the install-speed measurement (release gate
+# 2026-10-31): first boot, the desktop, and Claude Code answering. The macOS
+# half (app phases, engine phases with UTC start/end) is on the ESP as
+# /boot/efi/asahi/install-timing.jsonl, written by the installer engine.
+#   omarchy-install-timing boot      (system unit, once, after multi-user)
+#   omarchy-install-timing desktop   (Hyprland exec-once, once per install)
+#   omarchy-install-timing claude    (run by hand after `claude` answers)
+set -euo pipefail
+log=/var/log/omarchy/install-timing.jsonl
+esp=/boot/efi/asahi/install-timing.jsonl
+now() { date -u +%Y-%m-%dT%H:%M:%SZ; }
+emit() { printf '{"phase":"%s","at":"%s","uptime_s":%s%s}\n' "$1" "$(now)" \
+  "$(cut -d' ' -f1 /proc/uptime)" "${2:-}" | tee -a "$log" >/dev/null; }
+mkdir -p "${log%/*}" 2>/dev/null || true
+case ${1:-} in
+  boot)
+    [[ -e $log ]] && exit 0
+    [[ -r $esp ]] && sed 's/^{/{"source":"macos",/' "$esp" >>"$log"
+    emit linux_first_boot ",\"kernel\":\"$(uname -r)\",\"systemd_analyze\":\"$(systemd-analyze 2>/dev/null | head -1 | tr -d '"')\""
+    ;;
+  desktop)
+    grep -q '"phase":"desktop_ready"' "$log" 2>/dev/null && exit 0
+    renderer=$(eglinfo -B 2>/dev/null | grep -m1 'OpenGL renderer' | cut -d: -f2- | sed 's/^ *//; s/"//g' || true)
+    emit desktop_ready ",\"renderer\":\"${renderer:-unknown}\""
+    ;;
+  claude) emit claude_code_answering ",\"version\":\"$(claude --version 2>/dev/null | tr -d '"')\"" ;;
+  *) echo "usage: $0 boot|desktop|claude" >&2; exit 64 ;;
+esac
