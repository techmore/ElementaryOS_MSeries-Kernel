diff --git a/arch/arm64/boot/dts/apple/t8132-pmgr.dtsi b/arch/arm64/boot/dts/apple/t8132-pmgr.dtsi
--- a/arch/arm64/boot/dts/apple/t8132-pmgr.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-pmgr.dtsi
@@ -1137,3 +1137,68 @@
 		power-domains = <&ps_atc3_common>, <&ps_atc3_usb_aon>;
 	};
 };
+
+/* Offsets decoded from the J773g ADT pmgr device table (psreg 12). */
+&pmgr_audio {
+	ps_audio_a: power-controller@20 {
+		compatible = "apple,t8132-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x20 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "audio_a";
+	};
+
+	ps_audio_fr: power-controller@90 {
+		compatible = "apple,t8132-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x90 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "audio_fr";
+		power-domains = <&ps_audio_a>;
+	};
+
+	ps_audio_p: power-controller@b8 {
+		compatible = "apple,t8132-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0xb8 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "audio_p";
+		power-domains = <&ps_audio_fr>;
+	};
+
+	ps_audio_base_ns_a: power-controller@d8 {
+		compatible = "apple,t8132-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0xd8 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "audio_base_ns_a";
+		power-domains = <&ps_audio_p>;
+	};
+
+	ps_audio_mca0_m: power-controller@e8 {
+		compatible = "apple,t8132-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0xe8 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "audio_mca0_m";
+		power-domains = <&ps_audio_p>;
+	};
+
+	ps_audio_mca1_m: power-controller@f0 {
+		compatible = "apple,t8132-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0xf0 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "audio_mca1_m";
+		power-domains = <&ps_audio_p>;
+	};
+
+	ps_audio_mca2_m: power-controller@f8 {
+		compatible = "apple,t8132-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0xf8 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "audio_mca2_m";
+		power-domains = <&ps_audio_p>;
+	};
+};
diff --git a/arch/arm64/boot/dts/apple/t8132.dtsi b/arch/arm64/boot/dts/apple/t8132.dtsi
--- a/arch/arm64/boot/dts/apple/t8132.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132.dtsi
@@ -562,6 +562,15 @@
 			/* child nodes are added in t8132-pmgr.dtsi */
 		};
 
+		/* PMGR register window 1 + 0x4000 (J773g ADT pmgr ps-regs[12]). */
+		pmgr_audio: power-management@388284000 {
+			compatible = "apple,t8132-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd";
+			#address-cells = <1>;
+			#size-cells = <1>;
+			reg = <0x3 0x88284000 0 0x4000>;
+			/* child nodes are added in t8132-pmgr.dtsi */
+		};
+
 		wdt: watchdog@3882b0000 {
 			compatible = "apple,t8132-wdt", "apple,t8103-wdt";
 			reg = <0x3 0x882b0000 0x0 0x4000>;
@@ -1239,6 +1248,47 @@
 					<0 0 0 4 &port02 0 0 0 3>;
 			status = "disabled";
 		};
+	};
+};
+
+/* Speaker/headphone path: MCA serializers fed by the base admac. */
+&soc {
+	/* J773g ADT /arm-io/dart-aop (shared with AOP firmware). */
+	dart_audio: iommu@390f00000 {
+		status = "disabled";
+		compatible = "apple,t8132-dart", "apple,t8110-dart";
+		reg = <0x3 0x90f00000 0x0 0xc000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 457 IRQ_TYPE_LEVEL_HIGH>;
+		#iommu-cells = <1>;
+		power-domains = <&ps_audio_a>;
+		/* Exclude the firmware's low 256 MiB bypass/remap window. */
+		apple,dma-range = <0x100 0x10000000 0x0 0x10000000>;
+	};
+
+	mca: i2s@393600000 {
+		status = "disabled";
+		compatible = "apple,t8132-mca";
+		reg = <0x3 0x93600000 0x0 0xc000>;
+		#sound-dai-cells = <1>;
+		clocks = <&clkref>, <&clkref>, <&clkref>;
+		power-domains = <&ps_audio_p>, <&ps_audio_mca0_m>,
+				<&ps_audio_mca1_m>, <&ps_audio_mca2_m>;
+		dmas = <&admac 0>, <&admac 2>, <&admac 4>;
+		dma-names = "tx0a", "tx1a", "tx2a";
+	};
+
+	/* J773g ADT /arm-io/admac-base-ns. */
+	admac: dma-controller@393800000 {
+		status = "disabled";
+		compatible = "apple,t8132-admac";
+		reg = <0x3 0x93800000 0x0 0x34000>;
+		#dma-cells = <1>;
+		dma-channels = <26>;
+		interrupts-extended = <&aic AIC_IRQ 475 IRQ_TYPE_LEVEL_HIGH>,
+				      <0>, <0>, <0>;
+		iommus = <&dart_audio 8>;
+		power-domains = <&ps_audio_base_ns_a>;
 	};
 };
 
