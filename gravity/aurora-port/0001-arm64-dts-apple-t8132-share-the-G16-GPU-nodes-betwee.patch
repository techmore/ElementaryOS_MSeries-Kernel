From 943909652bafce169d6b03f2da5bf3586477d734 Mon Sep 17 00:00:00 2001
From: claude <noreply@anthropic.com>
Date: Sat, 31 Oct 2026 09:02:10 -0400
Subject: [PATCH 1/3] arm64: dts: apple: t8132: share the G16 GPU nodes between
 boards

The GPU, its mailbox, the GFX TVM gate and the reserved-memory
placeholders in t8132-j713-gpu.dtsi describe the T8132 SoC, not the
MacBook Air: the apertures (0x302600000, 0x300000000), the mailbox
interrupts (993-996), and the ps_gfx, pmp and pmp_report labels they use
all come from the shared t8132 files. Rename it to t8132-gpu.dtsi so
other T8132 boards can include it. No change for J713.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../boot/dts/apple/{t8132-j713-gpu.dtsi => t8132-gpu.dtsi}    | 4 ++--
 arch/arm64/boot/dts/apple/t8132-j713.dts                      | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)
 rename arch/arm64/boot/dts/apple/{t8132-j713-gpu.dtsi => t8132-gpu.dtsi} (94%)

diff --git a/arch/arm64/boot/dts/apple/t8132-j713-gpu.dtsi b/arch/arm64/boot/dts/apple/t8132-gpu.dtsi
similarity index 94%
rename from arch/arm64/boot/dts/apple/t8132-j713-gpu.dtsi
rename to arch/arm64/boot/dts/apple/t8132-gpu.dtsi
index 7cddbaf1e5b5..dce96dacdaf1 100644
--- a/arch/arm64/boot/dts/apple/t8132-j713-gpu.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-gpu.dtsi
@@ -1,6 +1,6 @@
 // SPDX-License-Identifier: GPL-2.0+ OR MIT
 /*
- * Apple MacBook Air (13-inch, M4) G16 GPU resources.
+ * Apple M4 (T8132) G16 GPU resources, shared by the boards that enable the GPU.
  *
  * Node structure follows the J713 ADT; values match the cleanroom J713 live
  * device tree. The Rust Asahi G16 backend is loaded explicitly after the
@@ -91,7 +91,7 @@ agx_mbox: mailbox@302608000 {
 	};
 };
 
-/* The outer TVM gate is the parent of the GFX PMGR domain on J713. */
+/* The outer TVM gate is the parent of the GFX PMGR domain on T8132. */
 &ps_gfx {
 	status = "okay";
 	power-domains = <&gfx_tvm>;
diff --git a/arch/arm64/boot/dts/apple/t8132-j713.dts b/arch/arm64/boot/dts/apple/t8132-j713.dts
index efaadea58306..0655d5a5d2a2 100644
--- a/arch/arm64/boot/dts/apple/t8132-j713.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j713.dts
@@ -504,5 +504,5 @@ fb_panel: panel {
 		status = "disabled";
 	};
 };
-#include "t8132-j713-gpu.dtsi"
+#include "t8132-gpu.dtsi"
 #include "t8132-j713-display.dtsi"
-- 
