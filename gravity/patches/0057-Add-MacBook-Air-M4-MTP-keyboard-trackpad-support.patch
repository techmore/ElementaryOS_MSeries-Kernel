 		memcpy(tail, msg + wsize, tsize);
-		ret = dockchannel_send(iface->dchid->dc, tail, sizeof(tail));
+		ret = dockchannel_send(dchid->dc, tail, sizeof(tail));
 		if (ret < 0)
