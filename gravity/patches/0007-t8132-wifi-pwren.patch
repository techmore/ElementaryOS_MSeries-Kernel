From bdafece9eddb4f6c107448f85671f5bec6baadf9 Mon Sep 17 00:00:00 2001
From: Yureka Lilian <yureka@cyberchaos.dev>
Date: Sat, 25 Jul 2026 16:48:40 +0200
Subject: [PATCH] t8132 wifi pwren

(cherry picked from commit c59a7a8266619c740e7859ce243aebbb5b30ae93)
---
 arch/arm64/boot/dts/apple/t8132-jxxx.dtsi | 8 ++++++++
 arch/arm64/boot/dts/apple/t8132.dtsi      | 3 +++
 2 files changed, 11 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132-jxxx.dtsi b/arch/arm64/boot/dts/apple/t8132-jxxx.dtsi
index efafc47da91da..871e8e3939cc6 100644
--- a/arch/arm64/boot/dts/apple/t8132-jxxx.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-jxxx.dtsi
@@ -47,6 +47,13 @@
 		device_type = "memory";
 		reg = <0x8 0 0x2 0>; /* To be filled by loader */
 	};
+
+	vreg_pcie0_port0: regulator-pcie0-port0 {
+		compatible = "regulator-fixed";
+		regulator-name = "pwren-pcie0-port0";
+		gpio = <&smc_gpio 19 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
 };
 
 &serial0 {
@@ -218,6 +225,7 @@
  * (such as MAC addresses).
  */
 &port00 {
+	power-supply = <&vreg_pcie0_port0>;
 	bus-range = <1 1>;
 	wifi0: wifi@0,0 {
 		compatible = "pci14e4,4434";
diff --git a/arch/arm64/boot/dts/apple/t8132.dtsi b/arch/arm64/boot/dts/apple/t8132.dtsi
index 4cf79413c2376..eadd04c46a5f8 100644
--- a/arch/arm64/boot/dts/apple/t8132.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132.dtsi
@@ -799,6 +799,7 @@
 			pinctrl-names = "default";
 
 			port00: pci@0,0 {
+				compatible = "pciclass,0604";
 				device_type = "pci";
 				reg = <0x0 0x0 0x0 0x0 0x0>;
 				reset-gpios = <&pinctrl_ap 163 GPIO_ACTIVE_LOW>; // perst
@@ -818,6 +819,7 @@
 			};
 
 			port01: pci@1,0 {
+				compatible = "pciclass,0604";
 				device_type = "pci";
 				reg = <0x800 0x0 0x0 0x0 0x0>;
 				reset-gpios = <&pinctrl_ap 164 GPIO_ACTIVE_LOW>; // perst
@@ -838,6 +840,7 @@
 			};
 
 			port02: pci@2,0 {
+				compatible = "pciclass,0604";
 				device_type = "pci";
 				reg = <0x1000 0x0 0x0 0x0 0x0>;
 				reset-gpios = <&pinctrl_ap 165 GPIO_ACTIVE_LOW>; // perst
-- 
