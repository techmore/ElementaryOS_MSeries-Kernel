 	platform_set_drvdata(pdev, mca);
 	clusters = mca->clusters;
 
-	mca->switch_base =
+	mca->switch_base = variant->switch_in_cluster ? base + variant->switch_off :
 		devm_platform_ioremap_resource(pdev, 1);
