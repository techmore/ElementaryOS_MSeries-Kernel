 			devm_kasprintf(&pdev->dev, GFP_KERNEL, "I2S%d TX", i);
@@ -1302,8 +1443,9 @@ static void apple_mca_remove(struct platform_device *pdev)
 }
 
 static const struct of_device_id apple_mca_of_match[] = {
-	{ .compatible = "apple,t8103-mca", },
