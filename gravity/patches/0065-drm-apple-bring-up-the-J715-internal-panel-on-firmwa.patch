From 1a0bfae9821e08c59c9044b0a347ab12e545a4f4 Mon Sep 17 00:00:00 2001
From: Josh Rodd <josh@rodd.us>
Date: Thu, 24 Sep 2026 15:32:56 -0400
Subject: [PATCH] drm/apple: bring up the J715 internal panel on firmware
 26.6.2

Enables the J715 panel and inherited display DARTs.
Map retained RTKit buffers safely.
Handle internal-panel service readiness and fixed timing.
Encode the 26.6.2 brightness ABI.
Preserve firmware modeset errors.
Keep this display-only change independent of the MTP input-support series.

Tested on M4 MacBook Air 15" only, not 13".

Suspend/resume and SMP is not tested yet due to lack of M4 support for
that yet.

Assisted-by: LLM
Signed-off-by: Josh Rodd <josh@rodd.us>
---
 arch/arm64/boot/dts/apple/t8132-j715.dts |  29 +++++++
 drivers/gpu/drm/apple/Kconfig            |   3 +-
 drivers/gpu/drm/apple/dcp-internal.h     |   2 -
 drivers/gpu/drm/apple/dcp.c              | 101 ++++++++++++++++++-----
 drivers/gpu/drm/apple/dcp_backlight.c    |  14 +++-
 drivers/gpu/drm/apple/iomfb_template.c   |  87 +++++++++++++++++--
 drivers/gpu/drm/apple/iomfb_template.h   |   6 ++
 drivers/gpu/drm/apple/iomfb_v26_6.c      |   7 ++
 8 files changed, 213 insertions(+), 36 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t8132-j715.dts b/arch/arm64/boot/dts/apple/t8132-j715.dts
index 2672914ea76c9..8e6fa70c6ebf4 100644
--- a/arch/arm64/boot/dts/apple/t8132-j715.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j715.dts
@@ -30,6 +30,35 @@
 	};
 };
 
+&dcp {
+	status = "okay";
+
+	panel: panel {
+		compatible = "apple,panel-j715", "apple,panel";
+		width-mm = <327>;
+		height-mm = <211>;
+		adj-height-mm = <204>;
+		apple,max-brightness = <500>;
+	};
+};
+
+&dcp_dart {
+	status = "okay";
+};
+
+&dcp_mbox {
+	status = "okay";
+};
+
+&disp0_dart {
+	status = "okay";
+};
+
+&framebuffer0 {
+	panel = <&panel>;
+	post-init-providers = <&panel>;
+};
+
 &fpwm1 {
 	status = "okay";
 };
