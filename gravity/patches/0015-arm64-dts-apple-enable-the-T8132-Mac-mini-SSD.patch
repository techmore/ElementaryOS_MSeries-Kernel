From b8d4a99bfec8046c99f2e391ab804d6677bcae44 Mon Sep 17 00:00:00 2001
From: Niklas Sheth <hi@niklassheth.com>
Date: Thu, 10 Sep 2026 23:22:02 -0400
Subject: [PATCH] arm64: dts: apple: enable the T8132 Mac mini SSD

Enable the internal NVMe controller for the persistent Linux root.
Queue-size programming is handled by the imported T8132 NVMe driver.

Assisted-By: OpenAI Codex (GPT-6 Astra)
Signed-off-by: Niklas Sheth <hi@niklassheth.com>
---
 arch/arm64/boot/dts/apple/t8132-j773g.dts | 5 ++---
 1 file changed, 2 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t8132-j773g.dts b/arch/arm64/boot/dts/apple/t8132-j773g.dts
index d6e2bb3a08c6d..b6c9f07da8b78 100644
--- a/arch/arm64/boot/dts/apple/t8132-j773g.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j773g.dts
@@ -111,10 +111,9 @@
 	dp2hdmi-pwren-gpios = <&smc_gpio 26 GPIO_ACTIVE_HIGH>;
 };
 
-/* This desktop experiment is entirely RAM/network backed. Do not expose the
- * internal SSD to userspace or desktop automounters. */
+/* The internal SSD is part of the M4 mini Linux bring-up environment. */
 &nvme {
-	status = "disabled";
+	status = "okay";
 };
 
 /*
