From bab8e9680feebe913b6e39c0b85199af630521ed Mon Sep 17 00:00:00 2001
From: Niklas Sheth <hi@niklassheth.com>
Date: Fri, 18 Sep 2026 03:08:37 -0400
Subject: [PATCH] arm64: dts: apple: add T8132 audio controllers and power
 domains

Describe the audio power-management block and its power hierarchy, audio DART, split-bank ADMAC and MCA TX0 route. Restrict the audio DMA aperture to avoid the firmware low-address bypass/remap window.

Leave the controllers disabled for board-level enablement.

Validation: the J773g device tree builds with these controller descriptions.

Assisted-By: OpenAI Codex (GPT-6 Astra)
Assisted-By: Claude Code (Claude Fable 5.1)
Signed-off-by: Niklas Sheth <hi@niklassheth.com>
---
 arch/arm64/boot/dts/apple/t8132-pmgr.dtsi | 47 +++++++++++++++++++++++
 arch/arm64/boot/dts/apple/t8132.dtsi      | 42 ++++++++++++++++++++
 2 files changed, 89 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132-pmgr.dtsi b/arch/arm64/boot/dts/apple/t8132-pmgr.dtsi
index 28395dd5d221b..6cc5889b77334 100644
--- a/arch/arm64/boot/dts/apple/t8132-pmgr.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-pmgr.dtsi
@@ -1131,3 +1131,50 @@
 		power-domains = <&ps_atc3_common>, <&ps_atc3_usb_aon>;
 	};
 };
+
+&pmgr_audio {
+	ps_audio_a: power-controller@20 {
+		compatible = "apple,t8132-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x20 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "audio_a";
+	};
+
+	ps_audio_fr: power-controller@90 {
+		compatible = "apple,t8132-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x90 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "audio_fr";
+		power-domains = <&ps_audio_a>;
+	};
+
+	ps_audio_p: power-controller@b8 {
+		compatible = "apple,t8132-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0xb8 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "audio_p";
+		power-domains = <&ps_audio_fr>;
+	};
+
+	ps_audio_base_ns_a: power-controller@d8 {
+		compatible = "apple,t8132-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0xd8 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "audio_base_ns_a";
+		power-domains = <&ps_audio_p>;
+	};
+
+	ps_audio_mca0_m: power-controller@e8 {
+		compatible = "apple,t8132-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0xe8 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "audio_mca0_m";
+		power-domains = <&ps_audio_p>;
+	};
+
+};
diff --git a/arch/arm64/boot/dts/apple/t8132.dtsi b/arch/arm64/boot/dts/apple/t8132.dtsi
index a8b9f87e6ce93..4b2576cfcbacd 100644
--- a/arch/arm64/boot/dts/apple/t8132.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132.dtsi
@@ -668,6 +668,48 @@
 			};
 		};
 
+		pmgr_audio: power-management@388284000 {
+			compatible = "apple,t8132-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd";
+			#address-cells = <1>;
+			#size-cells = <1>;
+			reg = <0x3 0x88284000 0 0x4000>;
+		};
+
+		dart_audio: iommu@390f00000 {
+			compatible = "apple,t8132-dart", "apple,t8110-dart";
+			reg = <0x3 0x90f00000 0 0x4000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 457 IRQ_TYPE_LEVEL_HIGH>;
+			#iommu-cells = <1>;
+			power-domains = <&ps_audio_a>;
+			/* Exclude the firmware's low 256 MiB bypass/remap window. */
+			apple,dma-range = <0x100 0x10000000 0 0x10000000>;
+			status = "disabled";
+		};
+
+		mca: i2s@393600000 {
+			compatible = "apple,t8132-mca";
+			reg = <0x3 0x93600000 0 0xc000>;
+			#sound-dai-cells = <1>;
+			clocks = <&clkref>;
+			power-domains = <&ps_audio_p>, <&ps_audio_mca0_m>;
+			dmas = <&admac 0>;
+			dma-names = "tx0a";
+			status = "disabled";
+		};
+
+		admac: dma-controller@393800000 {
+			compatible = "apple,t8132-admac";
+			reg = <0x3 0x93800000 0 0x34000>;
+			#dma-cells = <1>;
+			dma-channels = <26>;
+			interrupts-extended = <&aic AIC_IRQ 475 IRQ_TYPE_LEVEL_HIGH>,
+					      <0>, <0>, <0>;
+			iommus = <&dart_audio 8>;
+			power-domains = <&ps_audio_base_ns_a>;
+			status = "disabled";
+		};
+
 		pmgr_mini: power-management@388280000 {
 			compatible = "apple,t8132-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd";
 			#address-cells = <1>;
-- 
