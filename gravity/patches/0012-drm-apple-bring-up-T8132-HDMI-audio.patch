@@ -748,7 +748,8 @@ static void afk_recv_handle_compact_call(struct apple_dcp_afkep *ep,
 			 ep->endpoint, channel, le16_to_cpu(call->group),
 			 le32_to_cpu(call->command));
 	} else {
-		ret = service->ops->call(service, le32_to_cpu(call->command),
