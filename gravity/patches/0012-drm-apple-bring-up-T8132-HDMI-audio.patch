--- a/arch/arm64/boot/dts/apple/t8132-j773g.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j773g.dts
@@ -18,6 +18,7 @@
 
 	aliases {
 		ethernet0 = &ethernet0;
+		sio = &sio;
 	};
 };
 
@@ -40,6 +41,22 @@
 	power-domains = <&ps_dispext0_cpu>, <&ps_dptx_phy>;
 };
 
+&sio_dart {
+	status = "okay";
+};
+
+&sio_mbox {
+	status = "okay";
+};
+
+&sio {
+	status = "okay";
+};
+
+&dpaudio0 {
+	status = "okay";
+};
+
 &disp0_dart {
 	status = "okay";
