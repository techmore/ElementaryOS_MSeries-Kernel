 		label = "dispext0_cpu";
 		power-domains = <&ps_dispext0_fe>;
-		apple,min-state = <4>;
+		status = "disabled"; /* Locked, don't touch it */
 	};
 
 	ps_scodec: power-controller@228 {
@@ -785,6 +785,7 @@
