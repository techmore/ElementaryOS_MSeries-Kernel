+                        7 => {
+                            fw.read_u32(base + 12)? == a.fragment_event as u32
+                                && fw.read_u32(base + 16)? == a.fragment_stamp as u32
+                        }
+                        _ => false,
+                    };
+                    if matches {
+                        selected = Some(index);
+                        break;
+                    }
+                }
+            }
