+                    && fw.read_u32(base + 8)? == 0
+                    && fw.read_u64(base + 12)? == g16_fw::CONTROL_DATA
+                    && fw.read_u64(base + 20)? == g16_fw::OPERAND_TABLE
+                    && fw.read_u64(base + 28)? == g16_fw::OPERAND_TABLE
+                    && fw.read_u32(base + 36)? == 20 * 8)
