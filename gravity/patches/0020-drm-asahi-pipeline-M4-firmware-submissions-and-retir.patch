+    id: u64,
+    context: u32,
+    started: Instant<Monotonic>,
+    stamps: [Option<Stamp>; 2],
+    queues: [(u64, u32); 2],
+    channels: [(usize, u32); 2],
+    timestamps: [u64; 4],
+    render: Option<RenderFlight>,
