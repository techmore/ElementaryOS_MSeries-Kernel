+int afk_start_service(struct apple_epic_service *service)
+{
+	int ret;
+
+	if (!service || !service->enabled)
+		return -EINVAL;
+	if (!service->ep->compact)
+		return 0;
+	if (service->started)
+		return 0;
+
+	ret = afk_send_compact(service->ep, service->channel, 0x12, 0,
+			       NULL, 0, 0);
+	if (!ret)
+		service->started = true;
+	return ret;
+}
