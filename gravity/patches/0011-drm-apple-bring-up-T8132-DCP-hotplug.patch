+	if (obj->pool_fixed_iova) {
+		obj->dma.dma_addr = obj->pool_dma_addr;
+		obj->pool_fixed_iova = false;
+	}
+
+	apple_drm_gem_restore_direct_map(obj);
+	drm_gem_dma_free(&obj->dma);
