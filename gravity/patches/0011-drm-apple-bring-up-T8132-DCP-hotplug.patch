+	ret = afk_send_compact(ep, channel, EPIC_SUBTYPE_STD_SERVICE, 2,
+			       reply, payload_size, payload_size);
+	if (ret)
+		dev_err(ep->dcp->dev,
+			"AFK[ep:%02x]: failed to reply to compact service call: %d\n",
+			ep->endpoint, ret);
+	kfree(reply);
+}
