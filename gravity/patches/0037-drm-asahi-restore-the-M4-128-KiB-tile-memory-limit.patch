From 7af0f6c3789eb6393bfd56052a4b0fa34daa67ea Mon Sep 17 00:00:00 2001
From: Niklas Sheth <hi@niklassheth.com>
Date: Wed, 16 Sep 2026 00:35:28 -0400
Subject: [PATCH] drm/asahi: restore the M4 128 KiB tile-memory limit

The submission path rejects tile buffers larger than 32 blocks, even
though Parameters::valid() and the tile-buffer encoding support 64
blocks. This rejects the 88 KiB buffer used by a mixed-format MRT test
with normal 32x32 tiles.

Remove the redundant 32-block check and retain the existing 64-block
validation, restoring the supported 128 KiB limit.

Boot-tested on T8132 with the failing MRT case passing at normal tile
size. All seven previously failing ES 3.0 cases pass when combined with
the separate Mesa cross-context CPU fence-wait fix.

Assisted-By: OpenAI Codex (GPT-6 Astra)
Signed-off-by: Niklas Sheth <hi@niklassheth.com>
---
 drivers/gpu/drm/asahi/g16_drm.rs | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/asahi/g16_drm.rs b/drivers/gpu/drm/asahi/g16_drm.rs
index 70d3a643765d1..26c30041591b7 100644
--- a/drivers/gpu/drm/asahi/g16_drm.rs
+++ b/drivers/gpu/drm/asahi/g16_drm.rs
@@ -1738,7 +1738,7 @@ impl Vm {
         p.stencil_clear_value = u64::from(c.isp_bgobjvals);
         p.sampler_array = c.sampler_heap;
         p.sampler_count = u64::from(c.sampler_count);
-        if !p.valid() || p.sampler_count > 1024 || p.tib_blocks > 32 {
+        if !p.valid() || p.sampler_count > 1024 {
             return Err(EINVAL);
         }
         if p.sampler_count != 0 {
