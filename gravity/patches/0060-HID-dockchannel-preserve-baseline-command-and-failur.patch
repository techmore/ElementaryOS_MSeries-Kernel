+		ret = -EIO;
 	}
-	if (!ret)
-		ret = iface->out_error ?: (iface->retcode ? -EIO : iface->resp_size);
+
+done:
 	iface->tx_seq++;
-	iface->out_pending = false;
 	iface->out_report = -1;
+	iface->out_flags = 0;
 	iface->resp_buf = NULL;
 	iface->resp_size = 0;
-unlock:
-	spin_unlock_irqrestore(&iface->out_lock, flags);
 	mutex_unlock(&iface->out_mutex);
 	return ret;
 }
