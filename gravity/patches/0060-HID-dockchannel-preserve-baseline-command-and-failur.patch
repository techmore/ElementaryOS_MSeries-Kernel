+	memset(&h, 0, sizeof(h));
 	h.hdr.hdr_len = sizeof(h.hdr);
 	h.hdr.channel = DCHID_CHANNEL_CMD;
 	h.hdr.length = round_up(size, 4) + sizeof(h.sub);
