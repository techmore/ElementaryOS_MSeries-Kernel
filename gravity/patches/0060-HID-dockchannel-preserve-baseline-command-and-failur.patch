 	h.sub.flags = flags;
 	h.sub.length = size;
 
-	/* Interface locks do not serialize the shared byte stream. */
-	mutex_lock(&dchid->tx_mutex);
-	if (READ_ONCE(dchid->failed)) {
-		ret = -ESHUTDOWN;
-		goto unlock;
-	}
-
-	ret = dockchannel_send(dchid->dc, &h, sizeof(h));
+	ret = dockchannel_send(iface->dchid->dc, &h, sizeof(h));
 	if (ret < 0)
