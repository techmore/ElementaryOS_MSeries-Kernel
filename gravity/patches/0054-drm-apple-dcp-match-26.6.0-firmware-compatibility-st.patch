From 7b9ba99a50084ce5bf19a4e07a29f68269c39856 Mon Sep 17 00:00:00 2001
From: Niklas Sheth <hi@niklassheth.com>
Date: Sat, 19 Sep 2026 02:41:32 -0400
Subject: [PATCH] drm/apple: dcp: match 26.6.0 firmware compatibility string

Assisted-By: OpenAI Codex (GPT-6 Astra)
Signed-off-by: Niklas Sheth <hi@niklassheth.com>
---
 drivers/gpu/drm/apple/dcp.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/apple/dcp.c b/drivers/gpu/drm/apple/dcp.c
index 94ebd8aff55af..d427094d914c1 100644
--- a/drivers/gpu/drm/apple/dcp.c
+++ b/drivers/gpu/drm/apple/dcp.c
@@ -1596,7 +1596,7 @@ static enum dcp_firmware_version dcp_check_firmware_version(struct device *dev)
 		return DCP_FIRMWARE_V_13_5;
 	else if (strncmp(compat_str, "13.5.0", sizeof(compat_str)) == 0)
 		return DCP_FIRMWARE_V_13_5;
-	else if (strncmp(compat_str, "26.6.2", sizeof(compat_str)) == 0)
+	else if (strncmp(compat_str, "26.6.0", sizeof(compat_str)) == 0)
 		return DCP_FIRMWARE_V_26_6;
 
 	dev_err(dev, "DCP firmware-compat %s (FW: %s) is not supported\n",
-- 
