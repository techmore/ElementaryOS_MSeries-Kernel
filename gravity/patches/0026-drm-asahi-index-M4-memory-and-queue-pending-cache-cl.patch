@@ -457,18 +490,15 @@ impl FirmwareSpace {
     }
 
     pub(crate) fn write(&mut self, va: u64, bytes: &[u8]) -> Result {
-        let end = va.checked_add(bytes.len() as u64).ok_or(EINVAL)?;
-        let region = self
-            .regions
-            .iter()
-            .find(|r| va >= r.va && end <= r.va + (r.pages.len() * UAT_PGSZ) as u64)
